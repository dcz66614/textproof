--- /dev/null
+++ b/src/textproof/core/normalize.py
@@ -0,0 +1,130 @@
+"""§4.3 normalisation (PROJECT_BOOK.md).
+
+The single owner of the frozen §4.3 rules.  Both the expected text and
+the OCR text go through exactly the same functions, in exactly the
+order the spec lists them:
+
+1. Unicode NFC normalisation.
+2. ``CRLF`` / ``CR`` unified to ``LF``.
+3. Full-width ASCII mapped to half-width ASCII; full-width space
+   (U+3000) mapped to an ordinary space.
+4. Per line: leading/trailing whitespace stripped; consecutive
+   horizontal whitespace folded to a single space.
+5. Case sensitive; punctuation kept; no synonym replacement, no
+   semantic correction.
+6. Character indices are Unicode code-point indices into the
+   normalised text, spans half-open ``[start, end)``; the report keeps
+   the raw user / OCR text separately (see :mod:`textproof.core.report`).
+
+Notes on literal readings (frozen, do not "improve"):
+
+* Full-width mapping covers exactly U+FF01–U+FF5E (full-width ASCII
+  ``!``–``~``) plus U+3000.  U+FFE5 FULLWIDTH YEN SIGN (``￥``) is
+  *not* ASCII and is *not* mapped; the S0 sample TP-S0-NUM-001 uses
+  ``￥`` on both sides, so it compares equal either way, but mapping
+  it would invent a rule the spec does not state.
+* Horizontal whitespace folded by step 4 is space, tab, form feed,
+  vertical tab and the Unicode spaces (including NBSP and U+3000,
+  which step 3 already turned into a space).  Newlines are line
+  separators, never folded.
+* ``str.strip()`` / the fold regex use Python's Unicode whitespace
+  definitions; no locale-dependent behaviour is involved.
+"""
+
+from __future__ import annotations
+
+import re
+import unicodedata
+from typing import Iterable, Sequence
+
+__all__ = [
+    "FULLWIDTH_ASCII_START",
+    "FULLWIDTH_ASCII_END",
+    "FULLWIDTH_SPACE",
+    "normalize_text",
+    "normalize_line",
+    "normalize_lines",
+    "split_normalized_lines",
+    "normalize_expected_lines",
+]
+
+#: First full-width ASCII code point (U+FF01 FULLWIDTH EXCLAMATION MARK).
+FULLWIDTH_ASCII_START: int = 0xFF01
+#: Last full-width ASCII code point (U+FF5E FULLWIDTH TILDE).
+FULLWIDTH_ASCII_END: int = 0xFF5E
+#: Full-width space, mapped to an ordinary space by §4.3 step 3.
+FULLWIDTH_SPACE: str = "\u3000"
+
+#: Offset between a full-width ASCII code point and its half-width twin.
+_FULLWIDTH_OFFSET: int = 0xFEE0
+
+#: Runs of horizontal whitespace (space / tab / FF / VT / Unicode spaces).
+_HORIZONTAL_WS_RE: re.Pattern[str] = re.compile(
+    r"[ \t\x0b\x0c\u00a0\u1680\u2000-\u200a\u202f\u205f\u3000]+"
+)
+
+
+def _map_fullwidth_ascii(text: str) -> str:
+    """Map U+FF01–U+FF5E to U+0021–U+007E and U+3000 to U+0020 (§4.3.3)."""
+    out: list[str] = []
+    for ch in text:
+        cp = ord(ch)
+        if FULLWIDTH_ASCII_START <= cp <= FULLWIDTH_ASCII_END:
+            out.append(chr(cp - _FULLWIDTH_OFFSET))
+        elif ch == FULLWIDTH_SPACE:
+            out.append(" ")
+        else:
+            out.append(ch)
+    return "".join(out)
+
+
+def normalize_line(line: str) -> str:
+    """Normalise one line (§4.3 steps 1, 3, 4; no newline handling).
+
+    Assumes the line contains no ``\\r`` / ``\\n`` (use
+    :func:`normalize_text` for whole texts).  Applies NFC, full-width
+    mapping, then strip + horizontal-whitespace folding.
+    """
+    text = unicodedata.normalize("NFC", line)
+    text = _map_fullwidth_ascii(text)
+    text = _HORIZONTAL_WS_RE.sub(" ", text).strip()
+    return text
+
+
+def normalize_lines(lines: Iterable[str]) -> tuple[str, ...]:
+    """Normalise each line of an already-split sequence (§4.3).
+
+    Empty lines stay empty (a blank expected line is still a line; it
+    is not silently dropped, so line counts and indices stay honest).
+    """
+    return tuple(normalize_line(line) for line in lines)
+
+
+def normalize_text(text: str) -> str:
+    """Normalise a whole multi-line text (§4.3 steps 1–4, in order).
+
+    Newlines are unified to ``LF`` first (step 2), then each line is
+    normalised by :func:`normalize_line` and rejoined with ``LF``.
+    """
+    unified = text.replace("\r\n", "\n").replace("\r", "\n")
+    return "\n".join(normalize_line(line) for line in unified.split("\n"))
+
+
+def split_normalized_lines(text: str) -> tuple[str, ...]:
+    """Split a raw text into its normalised lines (§4.3).
+
+    Equivalent to ``tuple(normalize_text(text).split("\\n"))``; kept as
+    its own function because line splitting is what the aligner
+    consumes.
+    """
+    return tuple(normalize_text(text).split("\n"))
+
+
+def normalize_expected_lines(lines: Sequence[str]) -> tuple[str, ...]:
+    """Normalise T002's ``ExpectedTextInput.normalized_lines`` (§4.3).
+
+    T002 split on newlines only; the full §4.3 treatment (NFC,
+    full-width mapping, whitespace folding) is applied here, exactly
+    once, by this module.
+    """
+    return normalize_lines(lines)
diff --git a/src/textproof/core/report.py b/src/textproof/core/report.py
new file mode 100644
index 0000000..685e054
--- /dev/null
+++ b/src/textproof/core/report.py
@@ -0,0 +1,390 @@
+"""Report assembly: ``textproof.report/v1`` (PROJECT_BOOK.md §5, §7.6).
+
+Pipeline (each step owned by exactly one sibling module):
+
+1. ``normalize`` — §4.3 normalisation of the expected text and of
+   every OCR line (same rules on both sides).
+2. ``line_order`` — §4.4 reading order; OCR lines are reindexed, the
+   original order kept in ``source_order``.
+3. ``align_lines`` — §7.2 global line DP (gap 0.35, ambiguity margin
+   0.05, high-cost pair threshold 0.70).
+4. ``classify`` — §4.5/§7.4 character differences per aligned pair,
+   ``MISSING_LINE`` / ``EXTRA_LINE`` for unpaired lines.
+5. This module — verdict (§7.6), warnings, error ids, summary, and
+   the frozen §5.4 JSON shape.
+
+Verdict rules (§7.6, applied in this order):
+
+* No usable OCR text (no OCR lines at all, or every line normalises
+  to empty) → ``OCR_FAILED`` with an ``OCR_EMPTY`` warning and no
+  character/line errors: a failed recognition supports no
+  determination at all, so no ``MISSING_LINE`` is invented for it.
+* Ambiguous line alignment (two best paths within 0.05) →
+  ``REVIEW_REQUIRED`` with a single ``AMBIGUOUS_ALIGNMENT`` error and
+  no deterministic character conclusions (§7.2: "不输出确定性字符结论").
+* Otherwise: errors with no warnings → ``MISMATCH``; errors with any
+  warning → ``REVIEW_REQUIRED`` (this subsumes the §7.6 rule that a
+  difference on a sub-threshold line forces review — the general rule
+  is "若无警告且存在差异，才为 MISMATCH"); warnings with no errors →
+  ``REVIEW_REQUIRED``; neither → ``MATCH``.
+
+Warnings (§5.3, §7.6):
+
+* ``LOW_OCR_CONFIDENCE`` — an OCR line's confidence is below 0.65.
+  One warning per affected line, carrying its reading-order index.
+* ``OCR_EMPTY`` — no usable OCR text (see above).
+
+The warning codes ``POSSIBLE_MULTI_COLUMN`` and
+``ROTATED_TEXT_NOT_SUPPORTED`` are listed in §5.3 but no detector for
+them is specified in §4/§7, so this module does not invent one; they
+are left for the task that owns layout detection.  Emitting them
+without a specified rule would be fabrication.
+
+JSON shape (§5.4, §4.3.6):
+
+* Top-level ``expected_text`` is the user's *raw* expected text and
+  top-level ``recognized_text`` / ``ocr_lines[].text`` are the *raw*
+  OCR texts in reading order — the report retains the originals.
+* Error-level ``expected_text`` / ``recognized_text`` are the
+  *normalised* line texts, because the spans index into them.
+* Spans are half-open code-point spans into the normalised line.
+* A character difference's ``bbox_xyxy`` is its containing OCR line
+  box (``bbox_scope": "ocr_line"``); a ``MISSING_LINE`` has
+  ``bbox_xyxy": null`` and ``bbox_scope": null`` — never a fabricated
+  box (§4.6, §7.5).
+* Error ids are ``E001``, ``E002``, ... in deterministic order:
+  alignment order, and within a line, character order.
+
+``tool_version`` is ``"0.1.0"`` (IMPLEMENTATION_PLAN.md: "产品版本
+初始目标：0.1.0"; PROJECT_BOOK.md §5.4 sample).  It is the *product*
+version, distinct from the packaging version in ``pyproject.toml``.
+
+Determinism: no sets, no randomness, no wall-clock, no dict-order
+dependence anywhere in this pipeline — the same inputs produce the
+same report dict (tested in ``tests/unit/test_core/test_report.py``).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Final, Sequence, Union
+
+from textproof.contracts import (
+    COORDINATE_SYSTEM,
+    SCHEMA_ID,
+    ExpectedTextInput,
+    ImageInput,
+)
+from textproof.core.align_lines import align_lines
+from textproof.core.classify import (
+    Difference,
+    diffs_for_aligned_pair,
+    extra_line_difference,
+    missing_line_difference,
+)
+from textproof.core.line_order import order_lines
+from textproof.core.normalize import normalize_lines, split_normalized_lines
+from textproof.ocr.rapidocr_adapter import OCRLine
+
+__all__ = [
+    "TOOL_VERSION",
+    "LOW_CONFIDENCE_THRESHOLD",
+    "ComparisonResult",
+    "compare",
+    "build_report",
+    "difference_to_error",
+    "ambiguous_alignment_error",
+]
+
+#: Product version (IMPLEMENTATION_PLAN.md initial target; §5.4 sample).
+TOOL_VERSION: Final[str] = "0.1.0"
+#: OCR confidence below this adds LOW_OCR_CONFIDENCE (§7.6).
+LOW_CONFIDENCE_THRESHOLD: Final[float] = 0.65
+
+
+@dataclass
+class ComparisonResult:
+    """The comparison half of a ``textproof.report/v1`` report (§5.1).
+
+    ``errors`` / ``warnings`` / ``ocr_lines`` are JSON-ready dicts.
+    ``expected_text`` is the raw user text; ``recognized_text`` is the
+    raw OCR text (reading order, lines joined with ``\\n``).
+    """
+
+    verdict: str
+    errors: list[dict[str, object]] = field(default_factory=list)
+    warnings: list[dict[str, object]] = field(default_factory=list)
+    summary: dict[str, int] = field(default_factory=dict)
+    expected_text: str = ""
+    recognized_text: str = ""
+    ocr_lines: list[dict[str, object]] = field(default_factory=list)
+
+
+def difference_to_error(
+    difference: Difference,
+    error_id: str,
+    expected_line_text: str = "",
+    recognized_line_text: str = "",
+) -> dict[str, object]:
+    """Render one classified :class:`Difference` as a §5.4 error object.
+
+    ``expected_line_text`` / ``recognized_line_text`` are the
+    *normalised* line texts (spans index into them).  For line errors
+    they are the whole line, which equals the fragment; for character
+    errors they are the full normalised line while the fragment is
+    only the differing run.
+    """
+    return {
+        "id": error_id,
+        "type": difference.type,
+        "expected_line_index": difference.expected_line_index,
+        "ocr_line_index": difference.ocr_line_index,
+        "expected_text": expected_line_text,
+        "recognized_text": recognized_line_text,
+        "expected_span": (
+            list(difference.expected_span)
+            if difference.expected_span is not None
+            else None
+        ),
+        "recognized_span": (
+            list(difference.recognized_span)
+            if difference.recognized_span is not None
+            else None
+        ),
+        "expected_fragment": difference.expected_fragment,
+        "recognized_fragment": difference.recognized_fragment,
+        "bbox_xyxy": (
+            list(difference.bbox_xyxy) if difference.bbox_xyxy is not None else None
+        ),
+        "bbox_scope": "ocr_line" if difference.bbox_xyxy is not None else None,
+        "confidence": difference.confidence,
+    }
+
+
+def ambiguous_alignment_error(
+    expected_text: str, recognized_text: str
+) -> dict[str, object]:
+    """The single ``AMBIGUOUS_ALIGNMENT`` error (§4.4, §7.2).
+
+    No line indices, spans, fragments or bbox: the ambiguity is a
+    property of the whole alignment, and §7.2 forbids deterministic
+    character conclusions, so no character-level claim is attached.
+    """
+    return {
+        "id": "E001",
+        "type": "AMBIGUOUS_ALIGNMENT",
+        "expected_line_index": None,
+        "ocr_line_index": None,
+        "expected_text": expected_text,
+        "recognized_text": recognized_text,
+        "expected_span": None,
+        "recognized_span": None,
+        "expected_fragment": "",
+        "recognized_fragment": "",
+        "bbox_xyxy": None,
+        "bbox_scope": None,
+        "confidence": None,
+    }
+
+
+def _ocr_line_dict(line: OCRLine) -> dict[str, object]:
+    """One §5.4 ``ocr_lines`` entry (raw text retained, §4.3.6)."""
+    return {
+        "line_index": line.line_index,
+        "text": line.text,
+        "confidence": line.confidence,
+        "bbox_xyxy": list(line.bbox_xyxy),
+        "quad": [list(point) for point in line.quad],
+    }
+
+
+def compare(
+    expected: Union[str, ExpectedTextInput],
+    ocr_lines: Sequence[OCRLine],
+) -> ComparisonResult:
+    """Compare expected text against OCR lines; return the report body.
+
+    ``expected`` is the raw user text (or a T002
+    ``ExpectedTextInput``); ``ocr_lines`` are raw T003 ``OCRLine``
+    records in any order (reading order is derived here).  No image,
+    OCR engine or UI is involved — the core is testable on fixed OCR
+    line records alone (T004 completion definition).
+    """
+    raw_expected = expected.raw if isinstance(expected, ExpectedTextInput) else expected
+    if isinstance(expected, ExpectedTextInput):
+        expected_norm = normalize_lines(expected.normalized_lines)
+    else:
+        expected_norm = split_normalized_lines(raw_expected)
+
+    ordered = order_lines(list(ocr_lines))
+    recognized_norm = normalize_lines([ln.text for ln in ordered])
+    recognized_raw = "\n".join(ln.text for ln in ordered)
+
+    ocr_line_dicts = [_ocr_line_dict(ln) for ln in ordered]
+
+    warnings: list[dict[str, object]] = []
+    for ln in ordered:
+        if ln.confidence < LOW_CONFIDENCE_THRESHOLD:
+            warnings.append(
+                {
+                    "code": "LOW_OCR_CONFIDENCE",
+                    "message": (
+                        "OCR line confidence "
+                        f"{ln.confidence} is below {LOW_CONFIDENCE_THRESHOLD}."
+                    ),
+                    "ocr_line_index": ln.line_index,
+                }
+            )
+
+    usable = [i for i, text in enumerate(recognized_norm) if text != ""]
+    if not usable:
+        warnings.append(
+            {
+                "code": "OCR_EMPTY",
+                "message": "OCR produced no usable text.",
+            }
+        )
+        summary = {
+            "expected_lines": len(expected_norm),
+            "ocr_lines": len(ordered),
+            "error_count": 0,
+            "warning_count": len(warnings),
+        }
+        return ComparisonResult(
+            verdict="OCR_FAILED",
+            errors=[],
+            warnings=warnings,
+            summary=summary,
+            expected_text=raw_expected,
+            recognized_text=recognized_raw,
+            ocr_lines=ocr_line_dicts,
+        )
+
+    alignment = align_lines(list(expected_norm), list(recognized_norm))
+
+    if alignment.ambiguous:
+        errors = [
+            ambiguous_alignment_error(
+                "\n".join(expected_norm), "\n".join(recognized_norm)
+            )
+        ]
+        summary = {
+            "expected_lines": len(expected_norm),
+            "ocr_lines": len(ordered),
+            "error_count": len(errors),
+            "warning_count": len(warnings),
+        }
+        return ComparisonResult(
+            verdict="REVIEW_REQUIRED",
+            errors=errors,
+            warnings=warnings,
+            summary=summary,
+            expected_text=raw_expected,
+            recognized_text=recognized_raw,
+            ocr_lines=ocr_line_dicts,
+        )
+
+    differences: list[Difference] = []
+    for pair in alignment.pairs:
+        if pair.expected_index is not None and pair.ocr_index is not None:
+            differences.extend(
+                diffs_for_aligned_pair(
+                    expected_norm[pair.expected_index],
+                    recognized_norm[pair.ocr_index],
+                    pair.expected_index,
+                    pair.ocr_index,
+                    ordered[pair.ocr_index].bbox_xyxy,
+                    ordered[pair.ocr_index].confidence,
+                )
+            )
+        elif pair.expected_index is not None:
+            differences.append(
+                missing_line_difference(
+                    expected_norm[pair.expected_index], pair.expected_index
+                )
+            )
+        else:
+            assert pair.ocr_index is not None
+            differences.append(
+                extra_line_difference(
+                    recognized_norm[pair.ocr_index],
+                    pair.ocr_index,
+                    ordered[pair.ocr_index].bbox_xyxy,
+                    ordered[pair.ocr_index].confidence,
+                )
+            )
+
+    # Error-level line texts are the normalised line texts (spans index
+    # into them); fragments stay as classified.
+    errors: list[dict[str, object]] = []
+    for n, diff in enumerate(differences, start=1):
+        expected_line_text = (
+            expected_norm[diff.expected_line_index]
+            if diff.expected_line_index is not None
+            else ""
+        )
+        recognized_line_text = (
+            recognized_norm[diff.ocr_line_index]
+            if diff.ocr_line_index is not None
+            else ""
+        )
+        errors.append(
+            difference_to_error(
+                diff, f"E{n:03d}", expected_line_text, recognized_line_text
+            )
+        )
+
+    if errors and not warnings:
+        verdict = "MISMATCH"
+    elif errors or warnings:
+        verdict = "REVIEW_REQUIRED"
+    else:
+        verdict = "MATCH"
+
+    summary = {
+        "expected_lines": len(expected_norm),
+        "ocr_lines": len(ordered),
+        "error_count": len(errors),
+        "warning_count": len(warnings),
+    }
+    return ComparisonResult(
+        verdict=verdict,
+        errors=errors,
+        warnings=warnings,
+        summary=summary,
+        expected_text=raw_expected,
+        recognized_text=recognized_raw,
+        ocr_lines=ocr_line_dicts,
+    )
+
+
+def build_report(
+    image: ImageInput,
+    expected: Union[str, ExpectedTextInput],
+    ocr_lines: Sequence[OCRLine],
+) -> dict[str, object]:
+    """Build the full ``textproof.report/v1`` dict (§5.4).
+
+    ``image`` supplies the ``image`` block (SHA-256 of the original
+    bytes, oriented dimensions); the comparison half comes from
+    :func:`compare`.  The dict is JSON-serialisable as-is.
+    """
+    result = compare(expected, ocr_lines)
+    return {
+        "schema": SCHEMA_ID,
+        "tool_version": TOOL_VERSION,
+        "verdict": result.verdict,
+        "image": {
+            "sha256": image.sha256_hex(),
+            "format": image.format,
+            "width": image.width,
+            "height": image.height,
+            "coordinate_system": COORDINATE_SYSTEM,
+        },
+        "expected_text": result.expected_text,
+        "recognized_text": result.recognized_text,
+        "ocr_lines": result.ocr_lines,
+        "errors": result.errors,
+        "warnings": result.warnings,
+        "summary": result.summary,
+    }
diff --git a/src/textproof/core/weighted_edit.py b/src/textproof/core/weighted_edit.py
new file mode 100644
index 0000000..4961ca2
--- /dev/null
+++ b/src/textproof/core/weighted_edit.py
@@ -0,0 +1,233 @@
+"""§4.5 / §7.3 character-level weighted edit distance (PROJECT_BOOK.md).
+
+Frozen costs (§4.5 table — do not adjust):
+
+===========================  =====
+operation                    cost
+===========================  =====
+identical characters          0
+visual-confusion substitution 0.65
+punctuation substitution      0.50
+digit-to-digit substitution   1.25
+other substitution            1.00
+missing character (deletion)  1.00
+extra character (insertion)   1.00
+===========================  =====
+
+The DP is §7.3 exactly::
+
+    D[i, j] = min(D[i-1, j] + 1,            # missing character
+                  D[i, j-1] + 1,            # extra character
+                  D[i-1, j-1] + w(e_i, o_j))  # match / substitution
+
+Backtracking uses the fixed tie-break "diagonal (match /
+substitution) → missing → extra", so the same input always yields the
+same operation sequence and therefore the same report.
+
+Literal readings:
+
+* Confusion pairs are exactly the pairs the spec lists —
+  ``O/0``, ``I/1``, ``I/l``, ``1/l``, ``S/5``, ``B/8`` — as
+  unordered, case-sensitive pairs.  Lowercase ``o`` vs ``0`` is
+  *not* listed (the spec mixes cases deliberately: capital ``I``,
+  digit ``1``, lowercase ``l``), and §4.3 is case-sensitive, so it
+  falls through to "other substitution" (1.00).  The spec introduces
+  the list with "如" ("such as"), but no wider set is frozen anywhere,
+  so the listed set — and only it — is implemented; widening it would
+  be an unfrozen judgement call.
+* "Punctuation substitution" (0.50) requires *both* characters to be
+  Unicode punctuation (category ``P``).  A punctuation character
+  replaced by a letter is "other substitution".
+* "Digit" is Unicode decimal-digit category ``Nd`` (§7.4).  A
+  digit-to-digit substitution costs 1.25 here; its *classification*
+  (``NUMERIC_CHANGE``) lives in :mod:`textproof.core.classify`.
+* A confusion pair's lower cost only influences which alignment the
+  DP prefers.  A differing character *always* produces a difference
+  record — the DP emits a ``substitute`` op for it and
+  :mod:`textproof.core.classify` turns that op into an error (§4.5:
+  "只要字符不同仍必须产生差异记录").
+* Lengths and indices are Unicode code points (Python ``len`` on
+  ``str``); spans are half-open ``[start, end)`` into the normalised
+  text.
+"""
+
+from __future__ import annotations
+
+import unicodedata
+from dataclasses import dataclass
+from typing import Final, Literal
+
+__all__ = [
+    "COST_MATCH",
+    "COST_CONFUSION",
+    "COST_PUNCTUATION",
+    "COST_DIGIT",
+    "COST_SUBSTITUTION",
+    "COST_DELETE",
+    "COST_INSERT",
+    "CONFUSION_PAIRS",
+    "EditOp",
+    "EditResult",
+    "is_digit",
+    "is_punctuation",
+    "is_confusable",
+    "substitution_cost",
+    "weighted_edit_distance",
+    "weighted_edit_ops",
+]
+
+#: Identical normalised characters (§4.5).
+COST_MATCH: Final[float] = 0.0
+#: Visual-confusion-pair substitution (§4.5).
+COST_CONFUSION: Final[float] = 0.65
+#: Punctuation-to-punctuation substitution (§4.5).
+COST_PUNCTUATION: Final[float] = 0.50
+#: Digit-to-digit substitution (§4.5).
+COST_DIGIT: Final[float] = 1.25
+#: Any other substitution (§4.5).
+COST_SUBSTITUTION: Final[float] = 1.00
+#: Missing character — expected char absent from OCR (§4.5, §7.3).
+COST_DELETE: Final[float] = 1.00
+#: Extra character — OCR char absent from expected (§4.5, §7.3).
+COST_INSERT: Final[float] = 1.00
+
+#: Unordered visual-confusion pairs, exactly as listed in §4.5.
+CONFUSION_PAIRS: Final[frozenset[frozenset[str]]] = frozenset(
+    frozenset(pair)
+    for pair in (
+        ("O", "0"),
+        ("I", "1"),
+        ("I", "l"),
+        ("1", "l"),
+        ("S", "5"),
+        ("B", "8"),
+    )
+)
+
+OpKind = Literal["match", "substitute", "delete", "insert"]
+
+
+@dataclass(frozen=True)
+class EditOp:
+    """One step of the backtracked edit script (§7.3).
+
+    ``expected_index`` / ``recognized_index`` are code-point indices
+    into the normalised expected / recognised strings; ``None`` marks
+    the side that has no character for this op (``delete`` has no
+    recognised character, ``insert`` has no expected character).
+    """
+
+    kind: OpKind
+    expected_index: int | None
+    recognized_index: int | None
+
+
+@dataclass(frozen=True)
+class EditResult:
+    """Total weighted distance plus the deterministic op sequence."""
+
+    distance: float
+    ops: tuple[EditOp, ...]
+
+
+def is_digit(ch: str) -> bool:
+    """True iff ``ch`` is a Unicode decimal digit (category ``Nd``, §7.4)."""
+    return unicodedata.category(ch) == "Nd"
+
+
+def is_punctuation(ch: str) -> bool:
+    """True iff ``ch`` is Unicode punctuation (category ``P``)."""
+    return unicodedata.category(ch).startswith("P")
+
+
+def is_confusable(a: str, b: str) -> bool:
+    """True iff ``(a, b)`` is one of the frozen §4.5 confusion pairs."""
+    if a == b:
+        return False
+    return frozenset((a, b)) in CONFUSION_PAIRS
+
+
+def substitution_cost(a: str, b: str) -> float:
+    """Frozen §4.5 cost of replacing normalised char ``a`` with ``b``.
+
+    Precedence (the classes are disjoint except for the identical
+    case, so order is documentation, not a judgement call): identical
+    → confusion pair → digit-to-digit → punctuation-to-punctuation →
+    other.
+    """
+    if a == b:
+        return COST_MATCH
+    if is_confusable(a, b):
+        return COST_CONFUSION
+    if is_digit(a) and is_digit(b):
+        return COST_DIGIT
+    if is_punctuation(a) and is_punctuation(b):
+        return COST_PUNCTUATION
+    return COST_SUBSTITUTION
+
+
+def _dp_table(expected: str, recognized: str) -> list[list[float]]:
+    """Full §7.3 DP table (kept whole: backtracking needs every cell)."""
+    m, n = len(expected), len(recognized)
+    table: list[list[float]] = [[0.0] * (n + 1) for _ in range(m + 1)]
+    for i in range(1, m + 1):
+        table[i][0] = table[i - 1][0] + COST_DELETE
+    for j in range(1, n + 1):
+        table[0][j] = table[0][j - 1] + COST_INSERT
+    for i in range(1, m + 1):
+        e_ch = expected[i - 1]
+        row = table[i]
+        prev = table[i - 1]
+        for j in range(1, n + 1):
+            row[j] = min(
+                prev[j] + COST_DELETE,
+                row[j - 1] + COST_INSERT,
+                prev[j - 1] + substitution_cost(e_ch, recognized[j - 1]),
+            )
+    return table
+
+
+def weighted_edit_distance(expected: str, recognized: str) -> float:
+    """Minimum §7.3 weighted edit cost between two normalised strings."""
+    return _dp_table(expected, recognized)[len(expected)][len(recognized)]
+
+
+def weighted_edit_ops(expected: str, recognized: str) -> EditResult:
+    """Minimum-cost edit script, backtracked with the frozen tie-break.
+
+    At each step the diagonal (match / substitution) is preferred over
+    missing (deletion), which is preferred over extra (insertion).
+    Equality is tested on the exact float values the forward DP stored,
+    so the backtrack follows a genuinely optimal path.
+    """
+    table = _dp_table(expected, recognized)
+    m, n = len(expected), len(recognized)
+    ops: list[EditOp] = []
+    i, j = m, n
+    while i > 0 or j > 0:
+        if (
+            i > 0
+            and j > 0
+            and table[i][j]
+            == table[i - 1][j - 1]
+            + substitution_cost(expected[i - 1], recognized[j - 1])
+        ):
+            kind: OpKind = (
+                "match" if expected[i - 1] == recognized[j - 1] else "substitute"
+            )
+            ops.append(EditOp(kind, i - 1, j - 1))
+            i -= 1
+            j -= 1
+        elif i > 0 and table[i][j] == table[i - 1][j] + COST_DELETE:
+            ops.append(EditOp("delete", i - 1, None))
+            i -= 1
+        elif j > 0 and table[i][j] == table[i][j - 1] + COST_INSERT:
+            ops.append(EditOp("insert", None, j - 1))
+            j -= 1
+        else:  # pragma: no cover - unreachable if the table is consistent
+            raise AssertionError(
+                f"weighted-edit backtrack stuck at ({i}, {j}): "
+                "no predecessor reproduces the stored cost"
+            )
+    ops.reverse()
+    return EditResult(distance=table[m][n], ops=tuple(ops))
