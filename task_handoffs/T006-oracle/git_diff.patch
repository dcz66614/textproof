+def test_char_error_bbox_is_the_ocr_line_box():
+    bbox = [120, 180, 520, 252]
+    line = make_line("新口上市", bbox)
+    report = compare("新品上市", [line])
+    assert report["errors"][0]["bbox_xyxy"] == bbox
+    assert report["errors"][0]["bbox_scope"] == "ocr_line"
