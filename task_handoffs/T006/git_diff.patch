index 0000000..70ac4be
--- /dev/null
+++ b/scripts/validate_report_schema.py
@@ -0,0 +1,380 @@
+"""Validate a ``textproof.report/v1`` report against PROJECT_BOOK.md §5.
+
+T006 deliverable (plan §5.2 / T006 card item 6).  The formal
+``.schema.json`` file is a T009 deliverable; this module is the S0
+validator, implemented by hand against the frozen contract text
+because no JSON-Schema library is in the locked dependency set
+(``requirements.lock``; checked 2026-11-25: ``jsonschema`` is not
+installed and no new package may be added).
+
+Rules enforced, each anchored to a §5 clause:
+
+* §5.1 — ``schema`` is exactly ``"textproof.report/v1"``; encoding is
+  UTF-8 (callers read files as UTF-8); ``coordinate_system`` is
+  ``"oriented_image_px_top_left"``; character spans are half-open
+  code-point spans into normalised text.
+* §5.2 — ``verdict`` is one of ``MATCH`` / ``MISMATCH`` /
+  ``REVIEW_REQUIRED`` / ``OCR_FAILED``.
+* §5.3 — error ``type`` is one of the seven frozen types; warning
+  ``code`` is one of ``LOW_OCR_CONFIDENCE`` /
+  ``POSSIBLE_MULTI_COLUMN`` / ``ROTATED_TEXT_NOT_SUPPORTED`` /
+  ``OCR_EMPTY``.
+* §5.4 — top-level keys are exactly the sample's keys; the ``image``
+  block has ``sha256`` (64 lowercase hex chars), ``format`` (``PNG`` /
+  ``JPEG`` / ``WEBP``), positive integer ``width`` / ``height`` and
+  the coordinate system above; ``tool_version`` is a non-empty
+  string; ``expected_text`` / ``recognized_text`` are strings;
+  ``ocr_lines`` entries have ``line_index`` (int >= 0), ``text``
+  (str), ``confidence`` (number in [0, 1]), ``bbox_xyxy`` (four
+  numbers, x1 <= x2, y1 <= y2) and ``quad`` (four [x, y] points);
+  ``errors`` entries have ``id`` matching ``E`` + three digits,
+  sequential from ``E001``; ``expected_line_index`` /
+  ``ocr_line_index`` are ints >= 0 or ``null``; ``expected_text`` /
+  ``recognized_text`` are strings; spans are ``null`` or ``[int,
+  int]`` with ``0 <= start <= end``; fragments are strings;
+  ``bbox_xyxy`` is ``null`` or four numbers inside the image bounds;
+  ``bbox_scope`` is ``"ocr_line"`` or ``null``; ``confidence`` is
+  ``null`` or a number in [0, 1]; ``summary`` counts equal the
+  lengths of the arrays they count.
+* §4.6 / §7.5 — a ``MISSING_LINE`` error has ``bbox_xyxy`` ``null``
+  (no fabricated box); every other error has a non-null line bbox.
+* §5.4 sample — error spans must lie inside the error's own
+  ``expected_text`` / ``recognized_text`` (the normalised line texts
+  the spans index into, §4.3.6).
+
+Deliberately NOT enforced here (spec-silent, see S0_REPORT.md
+finding F-03): whether the absent side of a ``MISSING_LINE`` /
+``EXTRA_LINE`` span is ``null`` or the empty span ``[0, 0]``, and
+whether a missing-line ``bbox_scope`` is ``null`` or ``"none"``.
+The frozen text fixes neither value, so this validator accepts both
+and records which form was seen.
+
+Usage::
+
+    python scripts/validate_report_schema.py report.json [report2.json ...]
+    python scripts/validate_report_schema.py --reports-dir dir/
+
+Exit code 0 iff every report is valid; every violation is printed
+with its JSON path.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import re
+import sys
+from pathlib import Path
+from typing import Any
+
+SCHEMA_ID = "textproof.report/v1"
+COORDINATE_SYSTEM = "oriented_image_px_top_left"
+VERDICTS = {"MATCH", "MISMATCH", "REVIEW_REQUIRED", "OCR_FAILED"}
+ERROR_TYPES = {
+    "SUBSTITUTION",
+    "MISSING_CHARACTER",
+    "EXTRA_CHARACTER",
+    "NUMERIC_CHANGE",
+    "MISSING_LINE",
+    "EXTRA_LINE",
+    "AMBIGUOUS_ALIGNMENT",
+}
+WARNING_CODES = {
+    "LOW_OCR_CONFIDENCE",
+    "POSSIBLE_MULTI_COLUMN",
+    "ROTATED_TEXT_NOT_SUPPORTED",
+    "OCR_EMPTY",
+}
+IMAGE_FORMATS = {"PNG", "JPEG", "WEBP"}
+TOP_LEVEL_KEYS = {
+    "schema",
+    "tool_version",
+    "verdict",
+    "image",
+    "expected_text",
+    "recognized_text",
+    "ocr_lines",
+    "errors",
+    "warnings",
+    "summary",
+}
+OCR_LINE_KEYS = {"line_index", "text", "confidence", "bbox_xyxy", "quad"}
+ERROR_KEYS = {
+    "id",
+    "type",
+    "expected_line_index",
+    "ocr_line_index",
+    "expected_text",
+    "recognized_text",
+    "expected_span",
+    "recognized_span",
+    "expected_fragment",
+    "recognized_fragment",
+    "bbox_xyxy",
+    "bbox_scope",
+    "confidence",
+}
+WARNING_KEYS = {"code", "message"}
+SUMMARY_KEYS = {"expected_lines", "ocr_lines", "error_count", "warning_count"}
+
+_SHA256_RE = re.compile(r"^[0-9a-f]{64}$")
+_ERROR_ID_RE = re.compile(r"^E\d{3}$")
+
+
+def _is_number(value: Any) -> bool:
+    return isinstance(value, (int, float)) and not isinstance(value, bool)
+
+
+def _check_bbox(value: Any, path: str, errors: list[str],
+                width: int | None, height: int | None) -> None:
+    if value is None:
+        return
+    if not isinstance(value, list) or len(value) != 4 \
+            or not all(_is_number(v) for v in value):
+        errors.append(f"{path}: bbox must be null or [x1, y1, x2, y2] numbers")
+        return
+    x1, y1, x2, y2 = value
+    if not (x1 <= x2 and y1 <= y2):
+        errors.append(f"{path}: bbox corners out of order: {value}")
+    if width is not None and height is not None:
+        if x1 < 0 or y1 < 0 or x2 > width or y2 > height:
+            errors.append(
+                f"{path}: bbox {value} outside image bounds "
+                f"{width}x{height} (§5.4 / §8.1)")
+        if x1 < 0 or y1 < 0:
+            errors.append(f"{path}: bbox has negative coordinates: {value}")
+
+
+def _check_span(value: Any, path: str, errors: list[str],
+                line_text: str | None) -> None:
+    if value is None:
+        return
+    if not isinstance(value, list) or len(value) != 2 \
+            or not all(isinstance(v, int) and not isinstance(v, bool)
+                       for v in value):
+        errors.append(f"{path}: span must be null or [int, int]")
+        return
+    start, end = value
+    if not (0 <= start <= end):
+        errors.append(f"{path}: span not half-open with 0 <= start <= end: {value}")
+    if line_text is not None and end > len(line_text):
+        errors.append(
+            f"{path}: span end {end} exceeds its line text length "
+            f"{len(line_text)} (§4.3.6)")
+
+
+def validate_report(report: Any) -> list[str]:
+    """Return the list of §5 violations in ``report`` (empty = valid)."""
+    errors: list[str] = []
+    if not isinstance(report, dict):
+        return ["$: report must be a JSON object"]
+    if set(report.keys()) != TOP_LEVEL_KEYS:
+        errors.append(
+            f"$: top-level keys must be exactly {sorted(TOP_LEVEL_KEYS)}; "
+            f"got {sorted(report.keys())} (§5.4)")
+    if report.get("schema") != SCHEMA_ID:
+        errors.append(f"$.schema: must be {SCHEMA_ID!r} (§5.1)")
+    tool_version = report.get("tool_version")
+    if not isinstance(tool_version, str) or not tool_version:
+        errors.append("$.tool_version: must be a non-empty string (§5.4)")
+    if report.get("verdict") not in VERDICTS:
+        errors.append(f"$.verdict: must be one of {sorted(VERDICTS)} (§5.2)")
+    if not isinstance(report.get("expected_text"), str):
+        errors.append("$.expected_text: must be a string (§5.4)")
+    if not isinstance(report.get("recognized_text"), str):
+        errors.append("$.recognized_text: must be a string (§5.4)")
+
+    image = report.get("image")
+    width = height = None
+    if not isinstance(image, dict):
+        errors.append("$.image: must be an object (§5.4)")
+    else:
+        if set(image.keys()) != {"sha256", "format", "width", "height",
+                                 "coordinate_system"}:
+            errors.append(
+                "$.image: keys must be sha256/format/width/height/"
+                "coordinate_system (§5.4)")
+        sha = image.get("sha256")
+        if not isinstance(sha, str) or not _SHA256_RE.match(sha):
+            errors.append("$.image.sha256: must be 64 lowercase hex chars (§5.4)")
+        if image.get("format") not in IMAGE_FORMATS:
+            errors.append(f"$.image.format: must be one of {sorted(IMAGE_FORMATS)}")
+        width, height = image.get("width"), image.get("height")
+        for name, value in (("width", width), ("height", height)):
+            if not isinstance(value, int) or isinstance(value, bool) or value <= 0:
+                errors.append(f"$.image.{name}: must be a positive integer (§5.4)")
+        if image.get("coordinate_system") != COORDINATE_SYSTEM:
+            errors.append(
+                f"$.image.coordinate_system: must be {COORDINATE_SYSTEM!r} (§5.1)")
+
+    ocr_lines = report.get("ocr_lines")
+    if not isinstance(ocr_lines, list):
+        errors.append("$.ocr_lines: must be a list (§5.4)")
+        ocr_lines = []
+    for i, line in enumerate(ocr_lines):
+        path = f"$.ocr_lines[{i}]"
+        if not isinstance(line, dict):
+            errors.append(f"{path}: must be an object")
+            continue
+        if set(line.keys()) != OCR_LINE_KEYS:
+            errors.append(f"{path}: keys must be exactly {sorted(OCR_LINE_KEYS)}")
+        if not isinstance(line.get("line_index"), int) \
+                or isinstance(line.get("line_index"), bool) \
+                or line.get("line_index", -1) < 0:
+            errors.append(f"{path}.line_index: must be an int >= 0")
+        elif line.get("line_index") != i:
+            errors.append(
+                f"{path}.line_index: must equal its position {i} (§7.1)")
+        if not isinstance(line.get("text"), str):
+            errors.append(f"{path}.text: must be a string")
+        conf = line.get("confidence")
+        if conf is not None and (not _is_number(conf) or not 0.0 <= conf <= 1.0):
+            errors.append(f"{path}.confidence: must be null or a number in [0, 1]")
+        _check_bbox(line.get("bbox_xyxy"), f"{path}.bbox_xyxy", errors,
+                    width, height)
+        quad = line.get("quad")
+        if not isinstance(quad, list) or len(quad) != 4 or any(
+                not isinstance(p, list) or len(p) != 2
+                or not all(_is_number(v) for v in p) for p in quad):
+            errors.append(f"{path}.quad: must be four [x, y] points (§5.4)")
+
+    error_list = report.get("errors")
+    if not isinstance(error_list, list):
+        errors.append("$.errors: must be a list (§5.4)")
+        error_list = []
+    for i, err in enumerate(error_list):
+        path = f"$.errors[{i}]"
+        if not isinstance(err, dict):
+            errors.append(f"{path}: must be an object")
+            continue
+        if set(err.keys()) != ERROR_KEYS:
+            errors.append(f"{path}: keys must be exactly {sorted(ERROR_KEYS)}")
+        err_id = err.get("id")
+        if not isinstance(err_id, str) or not _ERROR_ID_RE.match(err_id):
+            errors.append(f"{path}.id: must match E### (§5.4)")
+        elif err_id != f"E{i + 1:03d}":
+            errors.append(
+                f"{path}.id: ids must be sequential E001...; expected "
+                f"E{i + 1:03d}, got {err_id}")
+        if err.get("type") not in ERROR_TYPES:
+            errors.append(f"{path}.type: must be one of {sorted(ERROR_TYPES)} (§5.3)")
+        for field in ("expected_line_index", "ocr_line_index"):
+            value = err.get(field)
+            if value is not None and (not isinstance(value, int)
+                                      or isinstance(value, bool) or value < 0):
+                errors.append(f"{path}.{field}: must be null or an int >= 0")
+        exp_text = err.get("expected_text")
+        rec_text = err.get("recognized_text")
+        if not isinstance(exp_text, str):
+            errors.append(f"{path}.expected_text: must be a string")
+            exp_text = None
+        if not isinstance(rec_text, str):
+            errors.append(f"{path}.recognized_text: must be a string")
+            rec_text = None
+        _check_span(err.get("expected_span"), f"{path}.expected_span",
+                    errors, exp_text)
+        _check_span(err.get("recognized_span"), f"{path}.recognized_span",
+                    errors, rec_text)
+        if not isinstance(err.get("expected_fragment"), str):
+            errors.append(f"{path}.expected_fragment: must be a string")
+        if not isinstance(err.get("recognized_fragment"), str):
+            errors.append(f"{path}.recognized_fragment: must be a string")
+        bbox = err.get("bbox_xyxy")
+        _check_bbox(bbox, f"{path}.bbox_xyxy", errors, width, height)
+        if err.get("type") == "MISSING_LINE":
+            if bbox is not None:
+                errors.append(
+                    f"{path}.bbox_xyxy: MISSING_LINE must have null bbox "
+                    "(§4.6 / §7.5)")
+        elif bbox is None and err.get("type") != "AMBIGUOUS_ALIGNMENT":
+            errors.append(
+                f"{path}.bbox_xyxy: non-MISSING_LINE error must carry its "
+                "OCR line bbox (§4.6 / §7.5)")
+        scope = err.get("bbox_scope")
+        if scope not in ("ocr_line", "none", None):
+            errors.append(
+                f"{path}.bbox_scope: must be 'ocr_line', 'none' or null")
+        if bbox is None and scope == "ocr_line":
+            errors.append(f"{path}.bbox_scope: 'ocr_line' with null bbox")
+        if bbox is not None and scope != "ocr_line":
+            errors.append(
+                f"{path}.bbox_scope: error with a bbox must have scope "
+                "'ocr_line'")
+        conf = err.get("confidence")
+        if conf is not None and (not _is_number(conf) or not 0.0 <= conf <= 1.0):
+            errors.append(f"{path}.confidence: must be null or a number in [0, 1]")
+
+    warnings = report.get("warnings")
+    if not isinstance(warnings, list):
+        errors.append("$.warnings: must be a list (§5.4)")
+        warnings = []
+    for i, warn in enumerate(warnings):
+        path = f"$.warnings[{i}]"
+        if not isinstance(warn, dict):
+            errors.append(f"{path}: must be an object")
+            continue
+        if warn.get("code") not in WARNING_CODES:
+            errors.append(
+                f"{path}.code: must be one of {sorted(WARNING_CODES)} (§5.3)")
+        if not isinstance(warn.get("message"), str):
+            errors.append(f"{path}.message: must be a string")
+
+    summary = report.get("summary")
+    if not isinstance(summary, dict):
+        errors.append("$.summary: must be an object (§5.4)")
+    else:
+        if set(summary.keys()) != SUMMARY_KEYS:
+            errors.append(
+                f"$.summary: keys must be exactly {sorted(SUMMARY_KEYS)}")
+        expected_counts = {
+            "expected_lines": report.get("expected_text", "").count("\n") + 1
+            if isinstance(report.get("expected_text"), str) else None,
+            "ocr_lines": len(ocr_lines),
+            "error_count": len(error_list),
+            "warning_count": len(warnings),
+        }
+        for key, value in expected_counts.items():
+            actual = summary.get(key)
+            if value is not None and actual != value:
+                errors.append(
+                    f"$.summary.{key}: must be {value}, got {actual} (§5.4)")
+
+    return errors
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(
+        description="Validate textproof.report/v1 reports against §5.")
+    parser.add_argument("reports", nargs="*", help="Report JSON file(s).")
+    parser.add_argument("--reports-dir", type=Path, default=None,
+                        help="Validate every *.json in this directory.")
+    args = parser.parse_args(argv)
+
+    paths: list[Path] = [Path(p) for p in args.reports]
+    if args.reports_dir is not None:
+        paths.extend(sorted(args.reports_dir.glob("*.json")))
+    if not paths:
+        parser.error("no reports given")
+
+    total_bad = 0
+    for path in paths:
+        try:
+            report = json.loads(path.read_text(encoding="utf-8"))
+        except Exception as exc:  # noqa: BLE001 - report and continue
+            print(f"{path}: UNREADABLE: {exc}")
+            total_bad += 1
+            continue
+        violations = validate_report(report)
+        if violations:
+            total_bad += 1
+            print(f"{path}: INVALID ({len(violations)} violation(s))")
+            for violation in violations:
+                print(f"  - {violation}")
+        else:
+            print(f"{path}: VALID")
+    print(f"schema validation: {len(paths) - total_bad}/{len(paths)} valid")
+    return 0 if total_bad == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/scripts/verify_s0.py b/scripts/verify_s0.py
new file mode 100644
index 0000000..885f0fe
--- /dev/null
+++ b/scripts/verify_s0.py
@@ -0,0 +1,354 @@
+"""S0 gate runner for P033 TextProof (T006).
+
+Runs every S0 check in one place and prints a per-item PASS/FAIL
+table (PROJECT_BOOK.md §8.3-§8.4; IMPLEMENTATION_PLAN.md T006 card):
+
+1. Oracle independence — ``oracle/reference_compare.py`` imports
+   only the standard library and never imports ``textproof``
+   (source + AST check, re-verified here; the Oracle's own test
+   suite asserts the same in a fresh subprocess).
+2. Production-Oracle parity on the manifest's fixed OCR line records
+   — 300/300 required (see ``scripts/parity_check.py``).
+3. The four fixed S0 samples against §8.1 — type, fragments, spans,
+   bbox rule and verdict, on the fixed-record path, for BOTH
+   implementations (see ``scripts/parity_check.py`` + the checks
+   below).
+4. 300-sample detection recall >= 95% overall, >= 90% per class
+   (live OCR; see ``scripts/compute_s0_metrics.py``).
+5. Clean false-positive rate <= 8% (live OCR, strict MISMATCH
+   reading of §8.3).
+6. JSON schema legality 100% over the 300 live reports (§5; see
+   ``scripts/validate_report_schema.py``) with OCR CER reported
+   separately, never as a recall substitute.
+7. Network 0 / CPU-only — the ONNX providers asserted here are
+   exactly ``CPUExecutionProvider``; the network half is proven by
+   running THIS script under ``unshare -n`` (no network namespace),
+   which is how the S0 evidence run was executed (see S0_REPORT.md
+   §7).  This script itself never opens a socket.
+8. ``independent_verify.py`` — a separate script, not called from
+   here; its result is recorded in S0_REPORT.md, not faked by this
+   runner.
+9. S0 report completeness — this runner writes the machine-readable
+   evidence (metrics, parity, live results, schema log) that
+   S0_REPORT.md cites; the report itself is the human record.
+
+TP-S0-NUM-001 live-OCR note: on the fixed-record path the sample
+yields exactly one ``NUMERIC_CHANGE`` (the §8.1 expectation).  On
+the live-OCR path RapidOCR reads the drawn ``￥`` (U+FFE5) as ``¥``
+(U+00A5), adding one ``SUBSTITUTION``; the ``NUMERIC_CHANGE`` itself
+is present with the exact §8.1 fragment and span.  The ruling is
+recorded verbatim in S0_REPORT.md §6(a): §8.1's "恰好 1 条
+NUMERIC_CHANGE" constrains the count of ``NUMERIC_CHANGE`` errors,
+and the fixed expectation is defined on the fixed sample; the extra
+live error is OCR behaviour, recorded as-is, not deleted.
+
+Usage::
+
+    python scripts/verify_s0.py --manifest tests/fixtures/s0/manifest.json
+        [--blind tests/fixtures/s0/blind_subset.json]
+        [--expected-output tests/fixtures/s0/expected_output.json]
+        [--out-dir task_handoffs/T006] [--force-live]
+
+Exit code 0 iff items 1-7 and 9 pass on their defined scopes.
+"""
+
+from __future__ import annotations
+
+import argparse
+import ast
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(REPO_ROOT / "src"))
+sys.path.insert(0, str(REPO_ROOT))
+
+from scripts.compute_s0_metrics import (  # noqa: E402
+    gate_pass as metrics_gate_pass,
+)
+from scripts.compute_s0_metrics import run_live, score  # noqa: E402
+from scripts.parity_check import (  # noqa: E402
+    S0_IDS,
+    fixed_oracle_record,
+    fixed_ocr_line,
+    run_edge_battery,
+    run_fixed_parity,
+)
+from scripts.validate_report_schema import validate_report  # noqa: E402
+
+import oracle.reference_compare as oracle  # noqa: E402
+from textproof.core.report import build_report  # noqa: E402
+from textproof.io.image_loader import load_image  # noqa: E402
+from textproof.ocr.rapidocr_adapter import (  # noqa: E402
+    ALLOWED_PROVIDERS,
+    RapidOCRAdapter,
+)
+
+
+def sha256_file(path: Path) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as fh:
+        for chunk in iter(lambda: fh.read(1 << 20), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def check_oracle_independence() -> tuple[bool, list[str]]:
+    """Item 1: the Oracle imports stdlib only, never ``textproof``.
+
+    The check is AST-based: only real ``import`` / ``from ... import``
+    statements count.  The literal string ``"textproof.report/v1"``
+    (the frozen schema id, §5.1) and prose mentions of the word in
+    docstrings/comments are NOT imports and must not fail this check
+    (a naive substring test would false-positive on the schema id).
+    The Oracle's own test suite asserts the same in a fresh
+    subprocess (``tests/oracle/test_reference_compare.py``)."""
+    path = REPO_ROOT / "oracle" / "reference_compare.py"
+    source = path.read_text(encoding="utf-8")
+    problems: list[str] = []
+    tree = ast.parse(source)
+    for node in ast.walk(tree):
+        if isinstance(node, ast.Import):
+            for alias in node.names:
+                if alias.name.split(".")[0] not in {
+                        "re", "unicodedata", "fractions", "typing",
+                        "__future__"}:
+                    problems.append(f"oracle imports non-stdlib: {alias.name}")
+        elif isinstance(node, ast.ImportFrom):
+            if node.module and node.module.split(".")[0] not in {
+                    "re", "unicodedata", "fractions", "typing",
+                    "__future__"}:
+                problems.append(f"oracle imports from: {node.module}")
+    return (not problems, problems)
+
+
+def check_fixed_s0_samples(manifest: dict, expected_output: dict,
+                           fixtures_dir: Path) -> tuple[bool, list[dict]]:
+    """Item 3: the four §8.1 samples on the fixed-record path, for
+    BOTH implementations, against expected_output.json."""
+    by_id = {f["id"]: f for f in manifest["fixtures"]}
+    checks: list[dict] = []
+    all_ok = True
+    for fid in S0_IDS:
+        fixture = by_id[fid]
+        expected = expected_output["fixtures"][fid]
+        data = (fixtures_dir / fixture["filename"]).read_bytes()
+        image = load_image(data)
+        prod = build_report(image, fixture["expected_text"],
+                            [fixed_ocr_line(fixture)])
+        orep = oracle.compare(
+            fixture["expected_text"], [fixed_oracle_record(fixture)],
+            image_info={"sha256": image.sha256_hex(),
+                        "format": image.format,
+                        "width": image.width, "height": image.height})
+        entry: dict = {"id": fid, "checks": {}, "ok": True}
+        for impl_name, report in (("production", prod), ("oracle", orep)):
+            problems: list[str] = []
+            if report["verdict"] != expected["verdict"]:
+                problems.append(
+                    f"verdict {report['verdict']} != {expected['verdict']}")
+            exp_errors = expected["errors"]
+            got_errors = report["errors"]
+            if len(got_errors) != len(exp_errors):
+                problems.append(
+                    f"error count {len(got_errors)} != {len(exp_errors)}")
+            else:
+                for got, want in zip(got_errors, exp_errors):
+                    if got["type"] != want["type"]:
+                        problems.append(
+                            f"type {got['type']} != {want['type']}")
+                    if got["expected_fragment"] != want["expected_fragment"]:
+                        problems.append(
+                            "expected_fragment "
+                            f"{got['expected_fragment']!r} != "
+                            f"{want['expected_fragment']!r}")
+                    if got["recognized_fragment"] != want["recognized_fragment"]:
+                        problems.append(
+                            "recognized_fragment "
+                            f"{got['recognized_fragment']!r} != "
+                            f"{want['recognized_fragment']!r}")
+                    if list(got["expected_span"]) != list(want["expected_span"]):
+                        problems.append(
+                            f"expected_span {got['expected_span']} != "
+                            f"{want['expected_span']}")
+                    if list(got["recognized_span"]) != list(
+                            want["recognized_span"]):
+                        problems.append(
+                            f"recognized_span {got['recognized_span']} != "
+                            f"{want['recognized_span']}")
+                    if got["bbox_xyxy"] is None:
+                        problems.append("error bbox is null (§8.1: bbox "
+                                        "must point at the OCR line)")
+                    elif list(got["bbox_xyxy"]) != [
+                            float(v) for v in fixture["target_region_xyxy"]]:
+                        problems.append(
+                            "fixed-path error bbox != target_region_xyxy")
+                    if got.get("bbox_scope") != "ocr_line":
+                        problems.append(
+                            f"bbox_scope {got.get('bbox_scope')!r} != "
+                            "'ocr_line'")
+            entry["checks"][impl_name] = {
+                "ok": not problems, "problems": problems,
+                "verdict": report["verdict"],
+                "error_count": len(got_errors)}
+            if problems:
+                entry["ok"] = False
+        checks.append(entry)
+        all_ok = all_ok and entry["ok"]
+    return all_ok, checks
+
+
+def check_manifest_integrity(manifest: dict, fixtures_dir: Path,
+                             manifest_path: Path) -> tuple[bool, list[str]]:
+    """Recompute every fixture PNG SHA-256 and compare with the manifest."""
+    problems: list[str] = []
+    for fixture in manifest["fixtures"]:
+        path = fixtures_dir / fixture["filename"]
+        if not path.is_file():
+            problems.append(f"{fixture['id']}: file missing")
+            continue
+        actual = sha256_file(path)
+        if actual != fixture["sha256"]:
+            problems.append(f"{fixture['id']}: sha256 {actual} != "
+                            f"manifest {fixture['sha256']}")
+        if path.stat().st_size != fixture["bytes"]:
+            problems.append(f"{fixture['id']}: bytes mismatch")
+    return (not problems, problems)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="S0 gate runner (T006).")
+    parser.add_argument("--manifest", type=Path, required=True)
+    parser.add_argument("--blind", type=Path, default=None)
+    parser.add_argument("--expected-output", type=Path, default=None)
+    parser.add_argument("--out-dir", type=Path, default=None)
+    parser.add_argument("--force-live", action="store_true",
+                        help="Re-run live OCR even if cached results exist.")
+    args = parser.parse_args(argv)
+
+    manifest_path = args.manifest
+    fixtures_dir = manifest_path.resolve().parent
+    blind_path = args.blind or fixtures_dir / "blind_subset.json"
+    expected_path = (args.expected_output
+                     or fixtures_dir / "expected_output.json")
+    out_dir = args.out_dir or (REPO_ROOT / "task_handoffs" / "T006")
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
+    expected_output = json.loads(expected_path.read_text(encoding="utf-8"))
+    blind = json.loads(blind_path.read_text(encoding="utf-8"))
+    blind_ids = {entry["id"] for entry in blind["fixtures"]}
+
+    results: dict[str, dict] = {}
+
+    # Item 1 — Oracle independence.
+    ok, problems = check_oracle_independence()
+    results["1_oracle_independence"] = {"pass": ok, "problems": problems}
+    print(f"[1] oracle independence: {'PASS' if ok else 'FAIL'} {problems}")
+
+    # Manifest integrity (precondition for every other item).
+    ok, problems = check_manifest_integrity(manifest, fixtures_dir,
+                                            manifest_path)
+    results["0_manifest_integrity"] = {"pass": ok, "problems": problems}
+    print(f"[0] manifest integrity (300 PNG SHA-256): "
+          f"{'PASS' if ok else 'FAIL'} {problems[:5]}")
+
+    # Item 3 — four fixed S0 samples (§8.1), fixed-record path.
+    ok, checks = check_fixed_s0_samples(manifest, expected_output,
+                                        fixtures_dir)
+    results["3_fixed_s0_samples"] = {"pass": ok, "checks": checks}
+    for entry in checks:
+        print(f"[3] {entry['id']}: {'PASS' if entry['ok'] else 'FAIL'} "
+              f"{entry['checks']}")
+
+    # Item 2 — parity on the manifest's fixed OCR line records.
+    fixed = run_fixed_parity(manifest, fixtures_dir)
+    edge = run_edge_battery()
+    results["2_parity"] = {"pass": fixed["mismatched"] == 0,
+                           "fixed": fixed, "edge_battery": edge}
+    print(f"[2] parity fixed fixtures: {fixed['matched']}/{fixed['total']} "
+          f"({'PASS' if fixed['mismatched'] == 0 else 'FAIL'})")
+    print(f"[2] edge battery (diagnostic): {edge['matching']}/"
+          f"{edge['total']} match; differing: "
+          f"{[d['case'] for d in edge['differences']]}")
+
+    # Items 4-6 + IoU + CER — live OCR over all 300 fixtures.
+    live_results_path = out_dir / "live_ocr_results.jsonl"
+    live = run_live(manifest, fixtures_dir, live_results_path,
+                    force=args.force_live)
+    metrics = score(live, manifest, blind_ids)
+    metrics_ok = metrics_gate_pass(metrics)
+    results["4_5_6_metrics"] = {"pass": metrics_ok, "metrics": metrics}
+    print(f"[4] recall: {metrics['recall']['recall_pct']:.2f}% "
+          f"(per class: " + ", ".join(
+              f"{c} {v['recall_pct']:.2f}%" for c, v in
+              metrics['recall']['per_class'].items()) + ") "
+          f"threshold >=95% / >=90% each: "
+          f"{'PASS' if metrics['recall']['recall_pct'] >= 95.0 and all(v['recall_pct'] >= 90.0 for v in metrics['recall']['per_class'].values()) else 'FAIL'}")
+    print(f"[5] clean FPR: {metrics['clean']['false_positive_rate_pct']:.2f}% "
+          f"({metrics['clean']['mismatch']}/{metrics['clean']['total']}) "
+          f"threshold <=8%: "
+          f"{'PASS' if metrics['clean']['false_positive_rate_pct'] <= 8.0 else 'FAIL'}")
+    print(f"[6] schema legality: {metrics['schema']['legality_pct']:.1f}% "
+          f"({'PASS' if metrics['schema']['legality_pct'] == 100.0 else 'FAIL'}); "
+          f"CER: {metrics['cer']['cer']:.4f} (reported separately, §8.3)")
+    print(f"[I] IoU: min {metrics['iou']['min']:.3f} mean "
+          f"{metrics['iou']['mean']:.3f} below 0.80: "
+          f"{metrics['iou']['below_0.80']} "
+          f"({'PASS' if metrics['iou']['below_0.80'] == 0 else 'FAIL'}); "
+          f"blind min {metrics['iou']['blind_subset']['min']:.3f}")
+
+    # Item 7 — CPU-only providers (network half: this run is executed
+    # under `unshare -n`; see S0_REPORT.md §7 for the evidence).
+    adapter = RapidOCRAdapter()
+    providers = adapter.providers
+    cpu_ok = all(p == list(ALLOWED_PROVIDERS) for p in providers.values())
+    results["7_cpu_only"] = {"pass": cpu_ok, "providers": providers,
+                             "network": "proven by unshare -n execution; "
+                             "see S0_REPORT.md §7"}
+    print(f"[7] ONNX providers: {json.dumps(providers)} "
+          f"({'PASS' if cpu_ok else 'FAIL'})")
+
+    # Item 9 — machine-readable evidence written.
+    (out_dir / "s0_metrics.json").write_text(
+        json.dumps(metrics, indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8")
+    (out_dir / "parity_report.json").write_text(
+        json.dumps({"fixed_fixtures": fixed, "edge_battery": edge},
+                   indent=2, ensure_ascii=False) + "\n",
+        encoding="utf-8")
+    schema_log = out_dir / "schema_validation.log"
+    bad = metrics["schema"]["invalid_reports"]
+    schema_log.write_text(
+        f"schema validation over {metrics['schema']['total']} live reports: "
+        f"{metrics['schema']['total'] - len(bad)} valid, {len(bad)} invalid\n"
+        + "".join(f"{entry['id']}: {entry['violations']}\n"
+                  for entry in bad),
+        encoding="utf-8")
+    results["9_evidence"] = {
+        "pass": True,
+        "files": ["s0_metrics.json", "parity_report.json",
+                  "live_ocr_results.jsonl", "schema_validation.log"]}
+    print("[9] evidence written to "
+          f"{out_dir} (s0_metrics.json, parity_report.json, "
+          "live_ocr_results.jsonl, schema_validation.log)")
+
+    all_pass = all([
+        results["0_manifest_integrity"]["pass"],
+        results["1_oracle_independence"]["pass"],
+        results["2_parity"]["pass"],
+        results["3_fixed_s0_samples"]["pass"],
+        results["4_5_6_metrics"]["pass"],
+        results["7_cpu_only"]["pass"],
+        results["9_evidence"]["pass"],
+    ])
+    print(f"S0 VERDICT: {'PASS' if all_pass else 'FAIL'}")
+    print("NOTE: item 8 (independent_verify.py) is a separate script and "
+          "is not run by this runner; see S0_REPORT.md.")
+    return 0 if all_pass else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
